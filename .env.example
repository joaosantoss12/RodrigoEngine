# ── Supabase (dedicated project for this site, not shared with El Pedrito) ──
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Service-role key for the `subscribers` table — server-only, must NOT get a
# VITE_ prefix (that would ship it to the browser).
SUPABASE_SERVICE_KEY=

# ── Stripe ───────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Lifetime access price, in cents. Defaults to 19700 (197.00€) if unset.
LIFETIME_PRICE_CENTS=19700

# ── Telegram Login Widget (OIDC) ────────────────────────────────────────
# Create a bot via @BotFather (/newbot), then set this site's domain under
# Bot Settings > Web Login > Allowed URLs. client_id is the bot's numeric id
# (same number as the start of its bot token, before the colon). Can be the
# same bot as the group bot below, or a separate one.
TELEGRAM_CLIENT_ID=
VITE_TELEGRAM_CLIENT_ID=

# ── Telegram Group Bot (invite-link generation) ─────────────────────────
# Bot token from @BotFather. This bot must be an ADMIN of the private group
# below, with "Invite Users via Link" permission.
TELEGRAM_BOT_TOKEN=
# The group's chat id (negative number, e.g. -1001234567890). Get it by
# adding the bot to the group and calling getUpdates, or via @userinfobot.
TELEGRAM_GROUP_CHAT_ID=

# ── Session ──────────────────────────────────────────────────────────────
# Random secret used to sign the login cookie. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Used as a fallback for the Stripe success/cancel URLs if req.headers.origin
# is unavailable.
FRONTEND_URL=
